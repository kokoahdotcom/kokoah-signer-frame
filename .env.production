# PLACEHOLDER production-shaped configuration so `pnpm build` works locally and in CI checks.
# Real deploys MUST set every value below as environment variables in the deploy pipeline (they take precedence).
# The builder address below is a placeholder: HL rejects orders for an unapproved builder and the frontend refuses to
# trade when hello.builder differs from public-config, so it fails closed. scripts/postbuild.ts refuses a mainnet
# build with it. Domains are the kokoah-infra placeholders (.example).
VITE_HL_NETWORK=testnet
VITE_ALLOW_MAINNET_WRITES=false
VITE_ALLOWED_PARENT_ORIGINS=https://app.kokoah.example
VITE_BUILDER_ADDRESS=0x0000000000000000000000000000000000000001
VITE_BUILDER_FEE_TENTHS_BPS=45
VITE_AGENT_NAME=kokoah-web
