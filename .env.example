# Kokoah signer frame build configuration. Every value is baked into the public JavaScript at build time:
# NEVER put a secret here. Validated by src/frame/config.ts (the build fails on a bad value).
# Deploy pipelines set these as environment variables; they override .env.production.

# Hyperliquid network: testnet (default) | mainnet. Not secret.
VITE_HL_NETWORK=testnet

# Must be exactly "true" for a mainnet build (explicit opt-in to signing and submitting mainnet actions).
# Ignored on testnet. Not secret.
VITE_ALLOW_MAINNET_WRITES=false

# Comma-separated exact parent origins allowed to talk to (and embed) the frame. HTTPS only in production builds.
# Keep frame-ancestors in public/_headers in sync (the post-build step checks it). Not secret. Required.
VITE_ALLOWED_PARENT_ORIGINS=https://app.kokoah.example

# Kokoah builder address attached to every order, and its fee in tenths of a basis point (25 = 0.025%, max 100).
# Must match the backend's public-config (the frontend compares them after hello). Not secret. Required.
VITE_BUILDER_ADDRESS=0x0000000000000000000000000000000000000001
VITE_BUILDER_FEE_TENTHS_BPS=25
# Optional promotion: orders pay VITE_BUILDER_FEE_PROMO_TENTHS_BPS (default 0, at most the fee above) until
# VITE_BUILDER_FEE_PROMO_UNTIL (ISO 8601 with offset), then the fee above. Must match the backend's public-config.
# VITE_BUILDER_FEE_PROMO_UNTIL=2026-12-01T00:00:00Z
# VITE_BUILDER_FEE_PROMO_TENTHS_BPS=0

# Default agent name (1-16 of A-Z a-z 0-9 . _ -). Not secret. Optional.
VITE_AGENT_NAME=kokoah-web

# Development builds only (dev harness): replaces the Hyperliquid API base URL with the harness proxy/mock.
# Rejected in production builds. Not secret.
# VITE_HL_API_URL_OVERRIDE=http://localhost:47801/hl

# Post-build (scripts/postbuild.ts), not baked into the bundle:
# SIGNER_SITE_ORIGIN=https://signer.kokoah.example   # the release manifest's "site"
# RELEASE=v0.1.0                                       # manifest "version" (default: the git commit)
# GIT_COMMIT=<40-hex sha>                              # default: $GITHUB_SHA, then `git rev-parse HEAD`
# SOURCE_DATE_EPOCH=<unix seconds>                     # manifest "builtAt" (reproducible builds)
