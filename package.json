{
  "name": "@kokoah/signer-frame",
  "version": "0.1.0",
  "private": true,
  "description": "Kokoah signer frame: a separately deployed, separate-origin static page that holds the browser Hyperliquid agent key, checks policy and signs/submits trading actions requested over postMessage. Also ships the typed KokoahSignerClient for the frontend.",
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./client": {
      "types": "./dist-client/client/index.d.ts",
      "import": "./dist-client/client/index.js",
      "default": "./dist-client/client/index.js"
    },
    "./protocol": {
      "types": "./dist-client/protocol/index.d.ts",
      "import": "./dist-client/protocol/index.js",
      "default": "./dist-client/protocol/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-client",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "node dev/serve.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "HL_INTEGRATION=testnet vitest run test/integration",
    "build": "vite build && node scripts/postbuild.ts && node -e \"require('node:fs').rmSync('dist-client',{recursive:true,force:true})\" && tsc -p tsconfig.client.json",
    "build:frame": "vite build && node scripts/postbuild.ts",
    "build:client": "node -e \"require('node:fs').rmSync('dist-client',{recursive:true,force:true})\" && tsc -p tsconfig.client.json",
    "smoke:browser": "node scripts/smoke-browser.ts",
    "check": "tsc -p tsconfig.json --noEmit && vitest run && vite build && node scripts/postbuild.ts && node -e \"require('node:fs').rmSync('dist-client',{recursive:true,force:true})\" && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@kokoah/shared": "link:../kokoah-shared",
    "valibot": "1.5.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
